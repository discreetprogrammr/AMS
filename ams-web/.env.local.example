NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Automated PM ticket generation (app/api/cron/pm-due) — service-role key
# (Supabase dashboard > Project Settings > API > service_role) so the cron
# job can write without a signed-in session. Keep this OUT of any
# NEXT_PUBLIC_ variable — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` — set
# the same value here and in Vercel's project environment variables.
# Generate one with e.g. `openssl rand -hex 32`.
CRON_SECRET=your-random-secret

# How many days before an asset's next_service_due to auto-create its PM
# ticket/calendar event/alert. Optional — defaults to 7 if unset.
PM_REMINDER_LEAD_DAYS=7

# How many days before a compliance certificate's expiry_date or an asset's
# warranty_end_date to raise a staff "expiring soon" alert. Optional —
# defaults to 30 if unset.
COMPLIANCE_LEAD_DAYS=30

# Email notifications (SLA breaches, PM due, ticket status changes) —
# sends via Resend's HTTP API (https://resend.com), no SDK/npm install
# needed. All three optional: if RESEND_API_KEY or RESEND_FROM_EMAIL is
# unset, email sending is silently skipped everywhere (the in-app
# alerts/bell keep working regardless — email is an additional channel,
# not a replacement).
#
# RESEND_API_KEY — from the Resend dashboard (API Keys).
# RESEND_FROM_EMAIL — the "from" address. For quick testing before setting
# up your own domain, Resend's shared sandbox sender works:
# "HorizonCare360 <onboarding@resend.dev>" (can only send to the email
# you signed up to Resend with, until you verify your own domain).
# STAFF_NOTIFICATION_EMAIL — where SLA breach / PM due alerts go. A single
# shared address (e.g. an ops inbox), not per-technician — see lib/notify.ts.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=HorizonCare360 <onboarding@resend.dev>
STAFF_NOTIFICATION_EMAIL=ops@pacifichorizontek.com

# Browser push notifications (installable PWA) — the second notification
# channel alongside email, for the same three triggers (SLA breach, PM due,
# ticket status change). Uses Web Push (VAPID), sent via the `web-push` npm
# package (lib/push.ts). Optional as a set: if either key is unset, push
# sending is silently skipped everywhere (same graceful-degradation pattern
# as the Resend vars above).
#
# Generate your own keypair with:
#   node -e "const {publicKey,privateKey}=require('web-push').generateVAPIDKeys();console.log(publicKey,privateKey)"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser on purpose — it's
# the public half, used by pushManager.subscribe() client-side.
# VAPID_SUBJECT — a mailto: link push services may contact if your server
# is misbehaving. Use a real, monitored address.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:ops@pacifichorizontek.com
